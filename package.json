{
  "name": "workflow-studio",
  "version": "1.4.2",
  "description": "Premium workflow automation tool for gamers - automate repetitive tasks with human-like behavior",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit"
  },
  "author": "Grez Studios",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "better-sqlite3": "^11.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "opencv-wasm": "^4.3.0-10",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.grezstudios.workflowstudio",
    "productName": "Workflow Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "grezxune",
        "repo": "workflow-studio"
      }
    ],
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "directories": {
      "output": "dist"
    }
  }
}
