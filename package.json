{
  "name": "workflow-studio",
  "version": "1.6.1",
  "description": "Premium workflow automation tool for gamers - automate repetitive tasks with human-like behavior",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "gen:runtime": "node scripts/generate-runtime-bundle.mjs",
    "start": "bun run gen:runtime && electron-vite preview",
    "dev": "bun run gen:runtime && electron-vite dev",
    "build": "bun run gen:runtime && electron-vite build && electron-builder",
    "build:win": "bun run gen:runtime && electron-vite build && electron-builder --win",
    "build:mac": "bun run gen:runtime && electron-vite build && electron-builder --mac",
    "build:linux": "bun run gen:runtime && electron-vite build && electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "lint": "bun run lint:eslint && bun run typecheck",
    "lint:eslint": "eslint --max-warnings=0 \"src/main/**/*.ts\" \"src/preload/**/*.ts\" \"src/shared/**/*.ts\" \"src/types/**/*.d.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration"
  },
  "author": "Grez Studios",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^5.0.0",
    "esbuild": "0.27.3",
    "eslint": "^9.38.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.2",
    "better-sqlite3": "^11.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "html-react-parser": "^5.2.17",
    "opencv-wasm": "^4.3.0-10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.grezstudios.workflowstudio",
    "productName": "Workflow Studio",
    "publish": [
      {
        "provider": "github",
        "owner": "grezxune",
        "repo": "workflow-studio"
      }
    ],
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "installer/installer.nsh"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "directories": {
      "output": "dist"
    }
  }
}
